@page "{id?}"
@model Online_Examination_System.Pages.Admin.Users.EditModel
@{ var title = Model.IsNew ? L["New user"] : L["Edit user"]; ViewData["Title"] = title; }
<div class="page-header">
    <div>
        <a asp-page="Index" class="small text-decoration-none"><i class="bi bi-arrow-left"></i> @L["Users"]</a>
        <h1 class="h3 mb-0">@title</h1>
    </div>
</div>
<form method="post" enctype="multipart/form-data">
    <input asp-for="Input.Id" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">@L["Account"]</div>
                <div class="card-body row g-3">
                    <div class="col-md-6">
                        <label asp-for="Input.FullName" class="form-label">@L["Full name"]</label>
                        <input asp-for="Input.FullName" class="form-control" />
                        <span asp-validation-for="Input.FullName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Input.UserName" class="form-label">@L["Username"]</label>
                        <input asp-for="Input.UserName" class="form-control" />
                        <span asp-validation-for="Input.UserName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Input.Email" class="form-label">@L["Email"]</label>
                        <input asp-for="Input.Email" class="form-control" />
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Input.PhoneNumber" class="form-label">@L["Phone"]</label>
                        <input asp-for="Input.PhoneNumber" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Input.Password" class="form-label">@(Model.IsNew ? L["Password"] : L["New password (leave blank to keep)"])</label>
                        <input asp-for="Input.Password" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Picture" class="form-label">@L["Profile picture"]</label>
                        <input asp-for="Picture" type="file" accept="image/*" class="form-control" />
                        <span asp-validation-for="Picture" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card mb-4">
                <div class="card-header">@L["Role & status"]</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Input.Role" class="form-label">@L["Role"]</label>
                        <select asp-for="Input.Role" class="form-select" id="roleSelect">
                            @foreach (var r in Roles.All) { <option value="@r">@L[r]</option> }
                        </select>
                    </div>
                    <div>
                        <label asp-for="Input.Status" class="form-label">@L["Status"]</label>
                        <select asp-for="Input.Status" class="form-select">
                            @foreach (var s in Enum.GetValues<UserStatus>()) { <option value="@s">@L[s.ToString()]</option> }
                        </select>
                        <div class="form-text">@L["Inactive and suspended users cannot log in."]</div>
                    </div>
                </div>
            </div>
            <div class="card" id="studentBox">
                <div class="card-header">@L["Student details"]</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Input.StudentNumber" class="form-label">@L["Student number"]</label>
                        <input asp-for="Input.StudentNumber" class="form-control" />
                    </div>
                    <label class="form-label">@L["Classes"]</label>
                    @foreach (var c in Model.ClassOptions)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="Input.ClassIds" value="@c.Value" id="cls@(c.Value)" checked="@Model.Input.ClassIds.Contains(int.Parse(c.Value))" />
                            <label class="form-check-label" for="cls@(c.Value)">@c.Text</label>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="mt-4 d-flex gap-2">
        <button class="btn btn-primary"><i class="bi bi-check2"></i> @L["Save"]</button>
        <a asp-page="Index" class="btn btn-outline-secondary">@L["Cancel"]</a>
    </div>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var sel = document.getElementById('roleSelect'), box = document.getElementById('studentBox');
            function sync() { box.style.display = sel.value === 'Student' ? '' : 'none'; }
            sel.addEventListener('change', sync); sync();
        })();
    </script>
}
