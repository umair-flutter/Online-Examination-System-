@page "{id:int}"
@model Online_Examination_System.Pages.Admin.Classes.StudentsModel
@{ ViewData["Title"] = Model.ClassRoom.Name; }
<div class="page-header">
    <div>
        <a asp-page="Index" class="small text-decoration-none"><i class="bi bi-arrow-left"></i> @L["Classes"]</a>
        <h1 class="h3 mb-0">@Model.ClassRoom.Name <span class="text-muted fs-6">· @Model.Members.Count @L["students"]</span></h1>
    </div>
</div>
<div class="row g-4">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header">@L["Members"]</div>
            <ul class="list-group list-group-flush">
                @foreach (var s in Model.Members)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div><div class="fw-semibold">@s.FullName</div><div class="small text-muted">@s.UserName @(s.StudentNumber != null ? "· " + s.StudentNumber : "")</div></div>
                        <form method="post" asp-page-handler="Remove" asp-route-id="@Model.ClassRoom.Id">
                            <input type="hidden" name="studentId" value="@s.Id" />
                            <button class="btn btn-sm btn-outline-danger" data-confirm="@L["Remove this student from the class?"]"><i class="bi bi-person-dash"></i></button>
                        </form>
                    </li>
                }
                @if (Model.Members.Count == 0) { <li class="list-group-item"><div class="empty-state"><i class="bi bi-people"></i>@L["No students in this class yet."]</div></li> }
            </ul>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header">@L["Add students"]</div>
            <div class="card-body border-bottom">
                <form method="get" class="filter-bar">
                    <input name="search" value="@Model.Search" class="form-control" placeholder="@L["Search..."]" />
                    <button class="btn btn-outline-secondary"><i class="bi bi-search"></i></button>
                </form>
            </div>
            <form method="post" asp-page-handler="Add" asp-route-id="@Model.ClassRoom.Id">
                <div style="max-height:420px;overflow:auto">
                    <ul class="list-group list-group-flush">
                        @foreach (var s in Model.Available)
                        {
                            <li class="list-group-item">
                                <label class="form-check d-flex gap-2 mb-0">
                                    <input type="checkbox" class="form-check-input pick" name="studentIds" value="@s.Id" />
                                    <span>@s.FullName <span class="small text-muted">· @s.UserName</span></span>
                                </label>
                            </li>
                        }
                        @if (Model.Available.Count == 0) { <li class="list-group-item text-muted text-center py-4">@L["No more students to add."]</li> }
                    </ul>
                </div>
                @if (Model.Available.Count > 0)
                {
                    <div class="card-body d-flex justify-content-between">
                        <button type="button" class="btn btn-sm btn-link" onclick="document.querySelectorAll('.pick').forEach(c=>c.checked=true)">@L["Select all"]</button>
                        <button class="btn btn-primary"><i class="bi bi-person-plus"></i> @L["Add selected"]</button>
                    </div>
                }
            </form>
        </div>
    </div>
</div>
