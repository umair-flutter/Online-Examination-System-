@page
@model Online_Examination_System.Pages.Admin.Classes.IndexModel
@{ ViewData["Title"] = L["Classes"]; }
<div class="page-header">
    <h1 class="h3 mb-0">@L["Classes"]</h1>
    <div class="d-flex gap-2">
        <partial name="_ExportButtons" />
        <a asp-page="Edit" class="btn btn-primary"><i class="bi bi-plus-lg"></i> @L["New class"]</a>
    </div>
</div>
<div class="card table-card">
    <div class="card-body border-bottom">
        <form method="get" class="filter-bar">
            <input name="search" value="@Model.Search" class="form-control" placeholder="@L["Search..."]" />
            <button class="btn btn-outline-secondary"><i class="bi bi-search"></i></button>
        </form>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead><tr><th>@L["Name"]</th><th>@L["Students"]</th><th>@L["Exams"]</th><th>@L["Created"]</th><th></th></tr></thead>
            <tbody>
            @foreach (var c in Model.Items.Items)
            {
                <tr>
                    <td><div class="fw-semibold">@c.Name</div><div class="small text-muted">@c.Description</div></td>
                    <td><span class="badge text-bg-primary">@c.Students</span></td>
                    <td>@c.Exams</td>
                    <td class="small text-muted">@c.CreatedAt.ToString("d")</td>
                    <td class="text-end text-nowrap">
                        <a asp-page="Students" asp-route-id="@c.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-people"></i> @L["Students"]</a>
                        <a asp-page="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@c.Id" class="d-inline">
                            <button class="btn btn-sm btn-outline-danger" data-confirm="@L["Delete this class? Students will be removed from it."]"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
            @if (Model.Items.TotalCount == 0) { <tr><td colspan="5"><div class="empty-state"><i class="bi bi-people"></i>@L["No classes found."]</div></td></tr> }
            </tbody>
        </table>
    </div>
    <div class="card-body pt-0"><partial name="_Pager" model="Model.Items" /></div>
</div>
