@page
@model Online_Examination_System.Pages.Account.LoginModel
@{ ViewData["Title"] = L["Login"]; }
<div class="auth-wrap">
    <div class="card shadow-sm auth-card">
        <div class="card-body p-4 p-md-5">
            <div class="text-center mb-4">
                <i class="bi bi-mortarboard-fill text-primary display-5"></i>
                <h1 class="h4 mt-2">@L["Welcome back"]</h1>
                <p class="text-muted small">@L["Sign in to continue to ExamEase"]</p>
            </div>
            <form method="post">
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
                <div class="mb-3">
                    <label asp-for="Input.Login" class="form-label">@L["Username or email"]</label>
                    <input asp-for="Input.Login" class="form-control" autocomplete="username" autofocus />
                    <span asp-validation-for="Input.Login" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <div class="d-flex justify-content-between">
                        <label asp-for="Input.Password" class="form-label">@L["Password"]</label>
                        <a asp-page="/Account/ForgotPassword" class="small">@L["Forgot password?"]</a>
                    </div>
                    <div class="input-group">
                        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" id="pwd" />
                        <button class="btn btn-outline-secondary" type="button" data-toggle-password="pwd"><i class="bi bi-eye"></i></button>
                    </div>
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>
                <div class="form-check mb-3">
                    <input asp-for="Input.RememberMe" class="form-check-input" />
                    <label asp-for="Input.RememberMe" class="form-check-label">@L["Remember me"]</label>
                </div>
                <button class="btn btn-primary w-100 py-2" type="submit">@L["Login"]</button>
            </form>
            <p class="text-center small mt-4 mb-0">@L["Don't have an account?"] <a asp-page="/Account/Register">@L["Register"]</a></p>
        </div>
    </div>
</div>
<div class="container mb-5" style="max-width:680px">
    <div class="card border-0 bg-body-tertiary">
        <div class="card-body small">
            <div class="fw-semibold mb-2"><i class="bi bi-info-circle me-1"></i>@L["Demo accounts"]</div>
            <div class="d-flex flex-wrap gap-2">
                @foreach (var (role, u, p) in new[] { ("Admin", "nsadmin", "Admin@123"), ("Teacher", "samantha", "User@123"), ("Student", "athena", "User@123") })
                {
                    <button type="button" class="btn btn-sm btn-outline-secondary demo-login" data-user="@u" data-pass="@p">
                        @L[role]: <b>@u</b> / @p
                    </button>
                }
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll('.demo-login').forEach(function (b) {
            b.addEventListener('click', function () {
                document.getElementById('Input_Login').value = b.dataset.user;
                document.getElementById('pwd').value = b.dataset.pass;
            });
        });
    </script>
}
