@page
@model Online_Examination_System.Pages.Account.ForgotPasswordModel
@{ ViewData["Title"] = L["Forgot password"]; }
<div class="auth-wrap">
    <div class="card shadow-sm auth-card">
        <div class="card-body p-4 p-md-5">
            <div class="text-center mb-4">
                <i class="bi bi-key-fill text-primary display-5"></i>
                <h1 class="h4 mt-2">@L["Forgot password"]</h1>
            </div>
            @if (Model.Sent)
            {
                <div class="alert alert-success small">@L["If an account with that e-mail exists, a password reset link has been sent."]</div>
                @if (Model.DevLink != null)
                {
                    <div class="alert alert-warning small">
                        <b>Development:</b> SMTP is not configured, so the e-mail was saved to <code>App_Data/emails</code>.
                        <a href="@Model.DevLink" class="d-block mt-1 text-break">@L["Open reset link"]</a>
                    </div>
                }
            }
            else
            {
                <p class="text-muted small">@L["Enter your e-mail address and we will send you a link to reset your password."]</p>
                <form method="post">
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">@L["Email"]</label>
                        <input asp-for="Email" class="form-control" autofocus />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <button class="btn btn-primary w-100" type="submit">@L["Send reset link"]</button>
                </form>
            }
            <p class="text-center small mt-4 mb-0"><a asp-page="/Account/Login"><i class="bi bi-arrow-left"></i> @L["Back to login"]</a></p>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
