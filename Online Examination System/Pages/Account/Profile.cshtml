@page
@model Online_Examination_System.Pages.Account.ProfileModel
@{ ViewData["Title"] = L["My Profile"]; }
<partial name="_PageHeader" model='(L["My Profile"], (string?)null)' />
<div class="row g-4">
    <div class="col-lg-4">
        <div class="card text-center">
            <div class="card-body py-4">
                <partial name="_Avatar" model="Model.AppUser" view-data='new ViewDataDictionary(ViewData) { ["size"] = 110 }' />
                <h2 class="h5 mt-3 mb-0">@Model.AppUser.FullName</h2>
                <div class="text-muted small">@@@Model.AppUser.UserName</div>
                <div class="mt-2">@foreach (var r in Model.UserRoles) { <span class="badge text-bg-primary me-1">@L[r]</span> }</div>
                @if (!string.IsNullOrEmpty(Model.AppUser.ProfilePicture))
                {
                    <form method="post" asp-page-handler="RemovePicture" class="mt-3">
                        <button class="btn btn-sm btn-outline-danger" data-confirm="@L["Remove profile picture?"]"><i class="bi bi-trash"></i> @L["Remove picture"]</button>
                    </form>
                }
            </div>
            <ul class="list-group list-group-flush text-start small">
                <li class="list-group-item d-flex justify-content-between"><span class="text-muted">@L["Joined"]</span><span>@Model.AppUser.CreatedAt.ToString("d")</span></li>
                <li class="list-group-item d-flex justify-content-between"><span class="text-muted">@L["Last login"]</span><span>@(Model.AppUser.LastLoginAt?.ToString("g") ?? "-")</span></li>
                @if (Model.ClassNames.Count > 0)
                {
                    <li class="list-group-item d-flex justify-content-between"><span class="text-muted">@L["Classes"]</span><span>@string.Join(", ", Model.ClassNames)</span></li>
                }
            </ul>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card mb-4">
            <div class="card-header">@L["Edit profile"]</div>
            <div class="card-body">
                <form method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Input.FullName" class="form-label">@L["Full name"]</label>
                            <input asp-for="Input.FullName" class="form-control" />
                            <span asp-validation-for="Input.FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.Email" class="form-label">@L["Email"]</label>
                            <input asp-for="Input.Email" class="form-control" />
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.PhoneNumber" class="form-label">@L["Phone"]</label>
                            <input asp-for="Input.PhoneNumber" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.StudentNumber" class="form-label">@L["Student number"]</label>
                            <input asp-for="Input.StudentNumber" class="form-control" />
                        </div>
                        <div class="col-12">
                            <label asp-for="Picture" class="form-label">@L["Profile picture"]</label>
                            <input asp-for="Picture" type="file" class="form-control" accept="image/*" />
                            <span asp-validation-for="Picture" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="mt-4 d-flex gap-2">
                        <button class="btn btn-primary" type="submit"><i class="bi bi-check2"></i> @L["Save changes"]</button>
                        <a class="btn btn-outline-secondary" asp-page="/Account/ChangePassword"><i class="bi bi-key"></i> @L["Change Password"]</a>
                    </div>
                </form>
            </div>
        </div>
        @if (Model.Attachments.Count > 0)
        {
            <div class="card">
                <div class="card-header">@L["My attachments"]</div>
                <ul class="list-group list-group-flush">
                    @foreach (var a in Model.Attachments)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div><i class="bi bi-paperclip"></i> @a.FileName <span class="text-muted small">· @a.Size.FormatBytes()</span>
                                @if (!string.IsNullOrEmpty(a.Description)) { <div class="small text-muted">@a.Description</div> }
                            </div>
                            <a class="btn btn-sm btn-outline-primary" asp-page-handler="Download" asp-route-id="@a.Id"><i class="bi bi-download"></i></a>
                        </li>
                    }
                </ul>
            </div>
        }
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
