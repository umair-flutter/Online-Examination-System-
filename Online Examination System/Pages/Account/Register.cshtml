@page
@model Online_Examination_System.Pages.Account.RegisterModel
@{ ViewData["Title"] = L["Register"]; }
<div class="auth-wrap">
    <div class="card shadow-sm auth-card" style="max-width:560px">
        <div class="card-body p-4 p-md-5">
            <div class="text-center mb-4">
                <i class="bi bi-person-plus-fill text-primary display-5"></i>
                <h1 class="h4 mt-2">@L["Create your student account"]</h1>
            </div>
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Input.FullName" class="form-label">@L["Full name"]</label>
                        <input asp-for="Input.FullName" class="form-control" />
                        <span asp-validation-for="Input.FullName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Input.UserName" class="form-label">@L["Username"]</label>
                        <input asp-for="Input.UserName" class="form-control" autocomplete="username" />
                        <span asp-validation-for="Input.UserName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Input.Email" class="form-label">@L["Email"]</label>
                        <input asp-for="Input.Email" class="form-control" />
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Input.StudentNumber" class="form-label">@L["Student number"] <span class="text-muted small">(@L["optional"])</span></label>
                        <input asp-for="Input.StudentNumber" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Input.ClassRoomId" class="form-label">@L["Class"]</label>
                        <select asp-for="Input.ClassRoomId" asp-items="Model.ClassOptions" class="form-select"><option value="">— @L["Select"] —</option></select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Input.Password" class="form-label">@L["Password"]</label>
                        <input asp-for="Input.Password" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Input.ConfirmPassword" class="form-label">@L["Confirm password"]</label>
                        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                    </div>
                    <div class="col-12 small text-muted">@L["Password must have at least 6 characters including upper case, lower case, a digit and a symbol."]</div>
                </div>
                <button class="btn btn-primary w-100 py-2 mt-4" type="submit">@L["Register"]</button>
            </form>
            <p class="text-center small mt-4 mb-0">@L["Already have an account?"] <a asp-page="/Account/Login">@L["Login"]</a></p>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
