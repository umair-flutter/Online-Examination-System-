@page
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@{ ViewData["Title"] = L["Access denied"]; }
<div class="empty-state">
    <i class="bi bi-shield-lock text-danger"></i>
    <h1 class="h4">@L["Access denied"]</h1>
    <p>@L["You do not have permission to view this page."]</p>
    <a class="btn btn-primary" href="/Dashboard">@L["Back to dashboard"]</a>
</div>
