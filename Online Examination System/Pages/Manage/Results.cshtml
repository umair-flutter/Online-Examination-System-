@page
@model Online_Examination_System.Pages.Manage.ResultsModel
@{ ViewData["Title"] = L["Results"]; }
<div class="page-header">
    <h1 class="h3 mb-0">@L["Results"]</h1>
    <partial name="_ExportButtons" />
</div>
<div class="card table-card">
    <div class="card-body border-bottom">
        <form method="get" class="filter-bar">
            <input name="search" value="@Model.Search" class="form-control" placeholder="@L["Search student..."]" />
            <select name="examId" class="form-select" data-autosubmit>
                <option value="">@L["All exams"]</option>
                @foreach (var e in Model.ExamOptions) { <option value="@e.Value" selected="@(e.Value == Model.ExamId?.ToString())">@e.Text</option> }
            </select>
            <select name="classId" class="form-select" data-autosubmit>
                <option value="">@L["All classes"]</option>
                @foreach (var c in Model.ClassOptions) { <option value="@c.Value" selected="@(c.Value == Model.ClassId?.ToString())">@c.Text</option> }
            </select>
            <select name="outcome" class="form-select" data-autosubmit>
                <option value="">@L["All results"]</option>
                <option value="pass" selected="@(Model.Outcome == "pass")">@L["Passed"]</option>
                <option value="fail" selected="@(Model.Outcome == "fail")">@L["Failed"]</option>
                <option value="pending" selected="@(Model.Outcome == "pending")">@L["Pending Marking"]</option>
            </select>
            <button class="btn btn-outline-secondary"><i class="bi bi-search"></i></button>
        </form>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead><tr><th>@L["Student"]</th><th>@L["Exam"]</th><th>@L["Score"]</th><th>@L["Result"]</th><th>@L["Submitted"]</th><th></th></tr></thead>
            <tbody>
            @foreach (var a in Model.Items.Items)
            {
                <tr>
                    <td>@a.Student.FullName<div class="small text-muted">@a.Student.UserName</div></td>
                    <td><a asp-page="/Manage/Exams/Results" asp-route-id="@a.ExamId">@a.Exam.Title</a> <span class="small text-muted">#@a.AttemptNumber</span></td>
                    <td>@a.Score.ToString("0.##")/@a.TotalMarks.ToString("0.##") <span class="small text-muted">(@a.Percentage.ToString("0.#")%)</span></td>
                    <td>
                        @if (a.Status == AttemptStatus.PendingMarking) { <partial name="_StatusBadge" model="a.Status" /> }
                        else { <span class="badge @(a.IsPassed ? "text-bg-success" : "text-bg-danger")">@L[a.IsPassed ? "Passed" : "Failed"]</span> }
                        @if (a.ViolationCount > 0) { <span class="badge text-bg-danger"><i class="bi bi-eye"></i> @a.ViolationCount</span> }
                    </td>
                    <td class="small text-muted">@a.SubmittedAt?.ToString("g")</td>
                    <td class="text-end"><a asp-page="/Manage/Exams/Attempt" asp-route-id="@a.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye"></i></a></td>
                </tr>
            }
            @if (Model.Items.TotalCount == 0) { <tr><td colspan="6"><div class="empty-state"><i class="bi bi-bar-chart-line"></i>@L["No results found."]</div></td></tr> }
            </tbody>
        </table>
    </div>
    <div class="card-body pt-0"><partial name="_Pager" model="Model.Items" /></div>
</div>
