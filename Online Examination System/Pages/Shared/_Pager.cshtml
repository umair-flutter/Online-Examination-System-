@model IPaged
@{
    var q = Context.Request.Query;
    string Url(int p)
    {
        var dict = q.Where(kv => kv.Key != "p").ToDictionary(kv => kv.Key, kv => kv.Value.ToString());
        dict["p"] = p.ToString();
        return Context.Request.Path + "?" + string.Join("&", dict.Select(kv => $"{Uri.EscapeDataString(kv.Key)}={Uri.EscapeDataString(kv.Value)}"));
    }
    var start = Math.Max(1, Model.Page - 2);
    var end = Math.Min(Model.TotalPages, Model.Page + 2);
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3">
    <small class="text-muted">@L["Showing {0}–{1} of {2}", Model.FirstItem, Model.LastItem, Model.TotalCount]</small>
    @if (Model.TotalPages > 1)
    {
        <ul class="pagination pagination-sm mb-0">
            <li class="page-item @(Model.Page == 1 ? "disabled" : "")"><a class="page-link" href="@Url(Model.Page - 1)">&lsaquo;</a></li>
            @for (var i = start; i <= end; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")"><a class="page-link" href="@Url(i)">@i</a></li>
            }
            <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")"><a class="page-link" href="@Url(Model.Page + 1)">&rsaquo;</a></li>
        </ul>
    }
</div>
