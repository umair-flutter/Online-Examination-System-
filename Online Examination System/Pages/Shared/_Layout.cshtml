@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    var signedIn = SignInManager.IsSignedIn(User);
    var appUser = signedIn ? await UserManager.GetUserAsync(User) : null;
    var lang = Lang.Current;
    var path = Context.Request.Path.Value ?? "/";
    string Active(string prefix) => path.StartsWith(prefix, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}
<!DOCTYPE html>
<html lang="@lang.Code" dir="@(lang.IsRtl ? "rtl" : "ltr")" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ExamEase</title>
    <script>
        (function () { try { var t = localStorage.getItem('theme'); if (t) document.documentElement.setAttribute('data-bs-theme', t); } catch (e) { } })();
    </script>
    @if (lang.IsRtl)
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    }
    else
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    }
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@(signedIn ? "app-shell" : "public-shell")">
@if (signedIn && appUser != null)
{
    <aside class="sidebar" id="sidebar">
        <a class="sidebar-brand" asp-page="/Dashboard/Index"><i class="bi bi-mortarboard-fill"></i> <span>ExamEase</span></a>
        <nav class="sidebar-nav">
            <a class="@Active("/Dashboard")" asp-page="/Dashboard/Index"><i class="bi bi-speedometer2"></i> @L["Dashboard"]</a>

            @if (User.IsInRole(Roles.Student))
            {
                <div class="sidebar-heading">@L["Student"]</div>
                <a class="@Active("/Student/Exams")" asp-page="/Student/Exams"><i class="bi bi-journal-check"></i> @L["My Exams"]</a>
                <a class="@Active("/Student/Results")@Active("/Student/Result/")" asp-page="/Student/Results"><i class="bi bi-trophy"></i> @L["My Results"]</a>
            }

            @if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Teacher))
            {
                <div class="sidebar-heading">@L["Examination"]</div>
                <a class="@Active("/Manage/Questions")" asp-page="/Manage/Questions/Index"><i class="bi bi-collection"></i> @L["Question Bank"]</a>
                <a class="@Active("/Manage/Exams")" asp-page="/Manage/Exams/Index"><i class="bi bi-file-earmark-text"></i> @L["Exams"]</a>
                <a class="@Active("/Manage/Marking")" asp-page="/Manage/Marking"><i class="bi bi-pencil-square"></i> @L["Manual Marking"]</a>
                <a class="@Active("/Manage/Results")" asp-page="/Manage/Results"><i class="bi bi-bar-chart-line"></i> @L["Results"]</a>
            }

            @if (User.IsInRole(Roles.Admin))
            {
                <div class="sidebar-heading">@L["Administration"]</div>
                <a class="@Active("/Admin/Classes")" asp-page="/Admin/Classes/Index"><i class="bi bi-people"></i> @L["Classes"]</a>
                <a class="@Active("/Admin/Subjects")" asp-page="/Admin/Subjects/Index"><i class="bi bi-book"></i> @L["Subjects"]</a>
                <a class="@Active("/Admin/Users")" asp-page="/Admin/Users/Index"><i class="bi bi-person-gear"></i> @L["Users"]</a>
                <a class="@Active("/Admin/AuditLogs")" asp-page="/Admin/AuditLogs"><i class="bi bi-shield-check"></i> @L["Audit Logs"]</a>
            }

            <div class="sidebar-heading">@L["Account"]</div>
            <a class="@Active("/Notifications")" asp-page="/Notifications/Index"><i class="bi bi-bell"></i> @L["Notifications"]</a>
            <a class="@Active("/Account/Profile")" asp-page="/Account/Profile"><i class="bi bi-person-circle"></i> @L["My Profile"]</a>
        </nav>
    </aside>
    <div class="sidebar-backdrop" onclick="document.body.classList.remove('sidebar-open')"></div>

    <div class="main">
        <header class="topbar">
            <button class="btn btn-link text-body d-lg-none p-1" type="button" onclick="document.body.classList.toggle('sidebar-open')" aria-label="Menu">
                <i class="bi bi-list fs-4"></i>
            </button>
            <div class="ms-auto d-flex align-items-center gap-1">
                <partial name="_LanguageMenu" model="returnUrl" />
                <button class="btn btn-link text-body p-2" type="button" id="themeToggle" title="@L["Toggle dark mode"]"><i class="bi bi-moon-stars"></i></button>
                <a class="btn btn-link text-body p-2 position-relative" asp-page="/Notifications/Index" title="@L["Notifications"]">
                    <i class="bi bi-bell fs-5"></i>
                    <span id="notifBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none">0</span>
                </a>
                <div class="dropdown">
                    <button class="btn btn-link text-body text-decoration-none d-flex align-items-center gap-2" data-bs-toggle="dropdown" type="button">
                        <partial name="_Avatar" model="appUser" />
                        <span class="d-none d-md-inline">@appUser.FullName</span>
                        <i class="bi bi-chevron-down small"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow">
                        <li class="dropdown-header">@appUser.UserName · @string.Join(", ", await UserManager.GetRolesAsync(appUser))</li>
                        <li><a class="dropdown-item" asp-page="/Account/Profile"><i class="bi bi-person me-2"></i>@L["My Profile"]</a></li>
                        <li><a class="dropdown-item" asp-page="/Account/ChangePassword"><i class="bi bi-key me-2"></i>@L["Change Password"]</a></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <form method="post" asp-page="/Account/Logout">
                                <button class="dropdown-item text-danger" type="submit"><i class="bi bi-box-arrow-right me-2"></i>@L["Logout"]</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>
        <main class="content">
            <partial name="_Toasts" />
            @RenderBody()
        </main>
        <footer class="app-footer">&copy; @DateTime.Now.Year ExamEase · @L["Online Examination System"]</footer>
    </div>
}
else
{
    <nav class="navbar navbar-expand-md bg-body border-bottom sticky-top">
        <div class="container">
            <a class="navbar-brand fw-bold text-primary" asp-page="/Index"><i class="bi bi-mortarboard-fill"></i> ExamEase</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#pubNav"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="pubNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" asp-page="/Index">@L["Home"]</a></li>
                    <li class="nav-item"><a class="nav-link" href="/#features">@L["Features"]</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/Verify">@L["Verify Certificate"]</a></li>
                </ul>
                <div class="d-flex align-items-center gap-2">
                    <partial name="_LanguageMenu" model="returnUrl" />
                    <button class="btn btn-link text-body p-2" type="button" id="themeToggle"><i class="bi bi-moon-stars"></i></button>
                    <a class="btn btn-outline-primary" asp-page="/Account/Login">@L["Login"]</a>
                    <a class="btn btn-primary" asp-page="/Account/Register">@L["Register"]</a>
                </div>
            </div>
        </div>
    </nav>
    <main>
        <div class="container"><partial name="_Toasts" /></div>
        @RenderBody()
    </main>
    <footer class="border-top py-4 mt-5 text-muted small">
        <div class="container d-flex flex-wrap justify-content-between gap-2">
            <span>&copy; @DateTime.Now.Year ExamEase · @L["Online Examination System"]</span>
            <a asp-page="/Privacy" class="text-muted">@L["Privacy"]</a>
        </div>
    </footer>
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
