@{ var lang = Lang.Current; }
<!DOCTYPE html>
<html lang="@lang.Code" dir="@(lang.IsRtl ? "rtl" : "ltr")" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ExamEase</title>
    <script>(function () { try { var t = localStorage.getItem('theme'); if (t) document.documentElement.setAttribute('data-bs-theme', t); } catch (e) { } })();</script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/@(lang.IsRtl ? "bootstrap.rtl.min.css" : "bootstrap.min.css")" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="app-shell">
    <header class="topbar">
        <span class="fw-bold text-primary"><i class="bi bi-mortarboard-fill"></i> ExamEase</span>
        <span class="text-muted d-none d-md-inline">· @ViewData["Title"]</span>
        <div class="ms-auto d-flex align-items-center gap-3">
            @RenderSection("TopRight", required: false)
            <button class="btn btn-link text-body p-1" type="button" id="themeToggle"><i class="bi bi-moon-stars"></i></button>
        </div>
    </header>
    <main class="content">
        <div class="exam-shell">
            <partial name="_Toasts" />
            @RenderBody()
        </div>
    </main>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
