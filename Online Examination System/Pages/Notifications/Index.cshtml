@page
@model Online_Examination_System.Pages.Notifications.IndexModel
@{ ViewData["Title"] = L["Notifications"]; }
<div class="page-header">
    <h1 class="h3 mb-0">@L["Notifications"]</h1>
    <div class="d-flex gap-2">
        <form method="post" asp-page-handler="ReadAll"><button class="btn btn-outline-primary"><i class="bi bi-check2-all"></i> @L["Mark all as read"]</button></form>
        <form method="post" asp-page-handler="Clear"><button class="btn btn-outline-danger" data-confirm="@L["Delete all read notifications?"]"><i class="bi bi-trash"></i> @L["Clear read"]</button></form>
    </div>
</div>
<div class="card">
    <div class="list-group list-group-flush">
        @foreach (var n in Model.Items.Items)
        {
            <a asp-page-handler="Open" asp-route-id="@n.Id" class="list-group-item list-group-item-action d-flex gap-3 py-3 @(n.IsRead ? "" : "bg-primary-subtle")">
                <i class="bi @(n.IsRead ? "bi-bell" : "bi-bell-fill text-primary") fs-5"></i>
                <div class="flex-grow-1">
                    <div class="d-flex justify-content-between"><span class="fw-semibold">@L[n.Title]</span><small class="text-muted">@n.CreatedAt.ToString("g")</small></div>
                    <div class="small text-body-secondary">@n.Message</div>
                </div>
            </a>
        }
        @if (Model.Items.TotalCount == 0) { <div class="empty-state"><i class="bi bi-bell-slash"></i>@L["You have no notifications."]</div> }
    </div>
</div>
<partial name="_Pager" model="Model.Items" />
